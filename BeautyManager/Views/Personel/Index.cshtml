@model List<BeautyManager.Models.Personel>

<div class="topbar">
    <div>
        <h4><i class="fas fa-user-tie me-2" style="color:#E91E63"></i>Personel</h4>
        <small>Çalışanları buradan yönetin</small>
    </div>
    <a href="/Personel/Ekle" class="btn-new"><i class="fas fa-plus me-2"></i>Yeni Personel</a>
</div>

<div class="table-card">
    <h6><i class="fas fa-list me-2" style="color:#E91E63"></i>@Model.Count personel</h6>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-user-tie"></i>
            <p>Henüz personel eklenmemiş</p>
        </div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>Telefon</th>
                    <th>Uzmanlık</th>
                    <th>Bu Ay Randevu</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div style="color:#f0a0c0; font-weight:600">@p.Ad @p.Soyad</div>
                        </td>
                        <td style="color:#60a5fa">@p.Telefon</td>
                        <td>
                            <span style="background:rgba(156,39,176,0.15); color:#ce93d8; padding:4px 10px; border-radius:20px; font-size:0.8rem">
                                @p.Uzmanlik
                            </span>
                        </td>
                        <td>
                            <span style="background:rgba(13,110,253,0.15); color:#60a5fa; padding:4px 10px; border-radius:20px; font-size:0.8rem">
                                @p.Randevular.Count(r => r.RandevuTarihi.Month == DateTime.Now.Month) randevu
                            </span>
                        </td>
                        <td>
                            @if (p.Aktif)
                            {
                                <span class="badge-tamamlandi"><i class="fas fa-circle me-1"></i>Aktif</span>
                            }
                            else
                            {

                                <span class="badge-iptal"><i class="fas fa-circle me-1"></i>Pasif</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a href="/Personel/Duzenle/@p.Id" class="btn-edit">
                                    <i class="fas fa-edit me-1"></i>Düzenle
                                </a>
                                <a href="/Personel/Sil/@p.Id" class="btn-delete"
                                       onclick="return confirm('Personeli silmek istediğine emin misin?')">
                                    <i class="fas fa-trash me-1"></i>Sil
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>