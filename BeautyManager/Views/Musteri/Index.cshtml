@model List<BeautyManager.Models.Musteri>

<div class="topbar">
    <div>
        <h4><i class="fas fa-users me-2" style="color:#E91E63"></i>Müşteriler</h4>
        <small>Tüm müşterileri buradan yönetin</small>
    </div>
    <a href="/Musteri/Ekle" class="btn-new"><i class="fas fa-plus me-2"></i>Yeni Müşteri</a>
</div>

<!-- ARAMA -->
<div class="form-card mb-4">
    <form method="get" class="d-flex gap-3">
        <div class="flex-grow-1">
            <input type="text" name="ara" value="@ViewBag.Ara" class="form-control" placeholder="Ad, soyad veya telefon ile ara..." />
        </div>
        <button type="submit" class="btn-save">Ara</button>
        <a href="/Musteri" class="btn-edit">Temizle</a>
    </form>
</div>

<!-- MÜŞTERİ LİSTESİ -->
<div class="table-card">
    <h6><i class="fas fa-list me-2" style="color:#E91E63"></i>@Model.Count müşteri</h6>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-users"></i>
            <p>Müşteri bulunamadı</p>
        </div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>Telefon</th>
                    <th>Email</th>
                    <th>Kayıt Tarihi</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>
                            <div style="color:white; font-weight:600">@m.Ad @m.Soyad</div>
                        </td>
                        <td style="color:#ce93d8">@m.Telefon</td>
                        <td style="color:#6060a0">@m.Email</td>
                        <td style="color:#6060a0">@m.KayitTarihi.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="d-flex gap-1">
                                <a href="/Musteri/Detay/@m.Id" class="btn-success-soft" title="Detay">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a href="/Musteri/Duzenle/@m.Id" class="btn-edit" title="Düzenle">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/Musteri/Sil/@m.Id" class="btn-delete" title="Sil"
                                       onclick="return confirm('Müşteriyi silmek istediğine emin misin?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>