@model List<BeautyManager.Models.Musteri>

<div class="topbar">
    <div>
        <h4><i class="fas fa-users me-2" style="color:#E91E63"></i>Müşteriler</h4>
        <small>Tüm müşterileri buradan yönetin</small>
    </div>
    <a href="/Musteri/Ekle" class="btn-new"><i class="fas fa-plus me-2"></i>Yeni Müşteri</a>
</div>

<!-- ARAMA -->
<div class="form-card mb-4">
    <form method="get" class="d-flex gap-3">
        <div class="flex-grow-1">
            <input type="text" name="ara" value="@ViewBag.Ara" class="form-control" placeholder="Ad, soyad veya telefon ile ara..." />
        </div>
        <button type="submit" class="btn-save">Ara</button>
        <a href="/Musteri" class="btn-edit">Temizle</a>
    </form>
</div>

<!-- MÜŞTERİ LİSTESİ -->
<div class="table-card">
    <h6><i class="fas fa-list me-2" style="color:#E91E63"></i>@Model.Count müşteri</h6>
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-users"></i>
            <p>Müşteri bulunamadı</p>
        </div>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Ad Soyad</th>
                    <th>Telefon</th>
                    <th>Email</th>
                    <th>Kayıt Tarihi</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>
                            <div style="color:#f0a0c0; font-weight:600">@m.Ad @m.Soyad</div>
                        </td>
                        <td style="color:#60a5fa">@m.Telefon</td>
                        <td style="color:#9090b0">@m.Email</td>
                        <td>
                            <span style="background:rgba(111,66,193,0.15); color:#a78bfa; padding:4px 10px; border-radius:20px; font-size:0.8rem">
                                @m.KayitTarihi.ToString("dd MMM yyyy")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a href="/Musteri/Detay/@m.Id" class="btn-success-soft">
                                    <i class="fas fa-eye me-1"></i>Detay
                                </a>
                                <a href="/Musteri/Duzenle/@m.Id" class="btn-edit">
                                    <i class="fas fa-edit me-1"></i>Düzenle
                                </a>
                                <a href="/Musteri/Sil/@m.Id" class="btn-delete"
                                       onclick="return confirm('Müşteriyi silmek istediğine emin misin?')">
                                    <i class="fas fa-trash me-1"></i>Sil
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>