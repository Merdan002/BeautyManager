 <div class="topbar">
    <div>
        <h4><i class="fas fa-bolt me-2" style="color:#E91E63"></i>Yeni Lazer Seans Paketi</h4>
        <small>Yeni seans paketi oluşturun</small>
    </div>
    <a href="/LazerSeans" class="btn-edit"><i class="fas fa-arrow-left me-2"></i>Geri Dön</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="form-card">

            @if (ViewBag.Hata != null)
            {
                <div style="background:rgba(220,53,69,0.15); border:1px solid rgba(220,53,69,0.3);
                            color:#f87171; padding:12px 16px; border-radius:10px; margin-bottom:20px;">
                    <i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Hata
                </div>
            }

            <form method="post" action="/LazerSeans/Ekle">
                <input type="hidden" name="MusteriId" id="musteriId" />
                <input type="hidden" name="MusteriAdi" id="musteriAdiHidden" />

                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label">Müşteri</label>
                        <div class="arama-wrap">
                            <input type="text" id="musteriArama" class="form-control"
                                   placeholder="Ad, soyad veya telefon ile ara..." autocomplete="off" />
                            <div class="arama-liste" id="musteriListe"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Bölge</label>
                        <input type="text" name="Bolge" class="form-control"
                               list="bolgeList" placeholder="Örn: Bacak, Kol, Bikini" />
                        <datalist id="bolgeList">
                            <option value="Bacak"></option>
                            <option value="Kol"></option>
                            <option value="Bikini"></option>
                            <option value="Koltuk Altı"></option>
                            <option value="Yüz"></option>
                            <option value="Tam Vücut"></option>
                        </datalist>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Toplam Seans Sayısı</label>
                        <input type="number" name="ToplamSeans" class="form-control" placeholder="8" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Toplam Ücret (₺)</label>
                        <input type="number" name="ToplamUcret" step="0.01" class="form-control" placeholder="0.00" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Başlangıç Tarihi</label>
                        <input type="date" name="BaslangicTarihi" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Sonraki Seans Tarihi</label>
                        <input type="date" name="SonrakiSeansTarihi" class="form-control" />
                    </div>
                    <div class="col-12 d-flex gap-3">
                        <button type="submit" class="btn-save">
                            <i class="fas fa-save me-2"></i>Kaydet
                        </button>
                        <a href="/LazerSeans" class="btn-delete">İptal</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .arama-wrap { position: relative; }

    .arama-liste {
        position: absolute;
        top: 100%; left: 0; right: 0;
        background: #1a1a2e;
        border: 1px solid #E91E63;
        border-top: none;
        border-radius: 0 0 10px 10px;
        max-height: 220px;
        overflow-y: auto;
        z-index: 100;
        display: none;
    }

    .arama-liste.acik { display: block; }

    .arama-item {
        padding: 10px 15px;
        cursor: pointer;
        font-size: 0.88rem;
        color: #e0e0e0;
        border-bottom: 1px solid #2a2a4a;
        transition: background 0.15s;
    }

    .arama-item:last-child { border-bottom: none; }
    .arama-item:hover { background: rgba(233,30,99,0.15); color: white; }
    .arama-item .alt-bilgi { color: #6060a0; font-size: 0.78rem; margin-top: 2px; }
</style>

<script>
    var musteriler = [
        @foreach (var m in ViewBag.Musteriler as List<BeautyManager.Models.Musteri>)
        {
            <text>{ id: @m.Id, ad: "@m.Ad @m.Soyad", telefon: "@m.Telefon" },</text>
        }
    ];

    var input = document.getElementById('musteriArama');
    var liste = document.getElementById('musteriListe');
    var idInput = document.getElementById('musteriId');
    var adiInput = document.getElementById('musteriAdiHidden');

    input.addEventListener('input', function () {
        var aranan = this.value.toLowerCase().trim();
        adiInput.value = this.value;
        idInput.value = '';
        liste.innerHTML = '';

        var filtreli = aranan.length === 0 ? musteriler : musteriler.filter(function (m) {
            return m.ad.toLowerCase().includes(aranan) ||
                   (m.telefon && m.telefon.toLowerCase().includes(aranan));
        });

        if (filtreli.length === 0) {
            liste.innerHTML = '<div class="arama-item" style="color:#6060a0">Sonuç bulunamadı — yeni müşteri olarak eklenecek</div>';
        } else {
            filtreli.forEach(function (m) {
                var div = document.createElement('div');
                div.className = 'arama-item';
                div.innerHTML = '<div>' + m.ad + '</div><div class="alt-bilgi">' + m.telefon + '</div>';
                div.addEventListener('click', function () {
                    idInput.value = m.id;
                    adiInput.value = m.ad;
                    input.value = m.ad;
                    liste.classList.remove('acik');
                });
                liste.appendChild(div);
            });
        }
        liste.classList.add('acik');
    });

    input.addEventListener('focus', function () {
        liste.innerHTML = '';
        musteriler.forEach(function (m) {
            var div = document.createElement('div');
            div.className = 'arama-item';
            div.innerHTML = '<div>' + m.ad + '</div><div class="alt-bilgi">' + m.telefon + '</div>';
            div.addEventListener('click', function () {
                idInput.value = m.id;
                adiInput.value = m.ad;
                input.value = m.ad;
                liste.classList.remove('acik');
            });
            liste.appendChild(div);
        });
        liste.classList.add('acik');
    });

    document.addEventListener('click', function (e) {
        if (!input.contains(e.target) && !liste.contains(e.target))
            liste.classList.remove('acik');
    });
</script>