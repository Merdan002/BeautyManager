@model BeautyManager.Models.MalzemeStok

<div class="topbar">
    <div>
        <h4><i class="fas fa-edit me-2" style="color:#E91E63"></i>Ürün Düzenle</h4>
        <small>Stok bilgilerini güncelleyin</small>
    </div>
    <a href="/Stok" class="btn-edit"><i class="fas fa-arrow-left me-2"></i>Geri Dön</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="form-card">
            <form method="post">
                <input type="hidden" asp-for="Id" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Ürün Adı</label>
                        <input asp-for="UrunAdi" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Kategori</label>
                        <input asp-for="Kategori" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Miktar</label>
                        <input asp-for="Miktar" type="number" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Birim</label>
                        <select asp-for="Birim" class="form-select">
                            <option value="Adet">Adet</option>
                            <option value="ml">ml</option>
                            <option value="gr">gr</option>
                            <option value="Lt">Lt</option>
                            <option value="Kg">Kg</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Minimum Stok</label>
                        <input asp-for="MinimumStok" type="number" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Birim Fiyat (₺)</label>
                        <input asp-for="BirimFiyat" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="col-12 d-flex gap-3">
                        <button type="submit" class="btn-save"><i class="fas fa-save me-2"></i>Güncelle</button>
                        <a href="/Stok" class="btn-delete">İptal</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>