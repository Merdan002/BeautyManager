 @{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>BeautyManager — Giriş</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #0f0f1a;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-wrap {
            display: flex;
            width: 100%;
            max-width: 900px;
            min-height: 500px;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
        }

        .login-left {
            flex: 1;
            background: linear-gradient(135deg, #E91E63, #9C27B0);
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            color: white;
        }

        .login-left h2 { font-size: 2rem; font-weight: 800; margin-bottom: 15px; }
        .login-left p  { opacity: 0.85; font-size: 1rem; line-height: 1.7; }

        .login-left .features { margin-top: 30px; }
        .login-left .features div {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 15px;
            opacity: 0.9;
        }

        .login-left .features i {
            width: 36px; height: 36px;
            background: rgba(255,255,255,0.2);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
        }

        .login-right {
            width: 400px;
            background: #1a1a2e;
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-right h3 { color: white; font-weight: 700; margin-bottom: 8px; }
        .login-right p  { color: #6060a0; margin-bottom: 30px; font-size: 0.9rem; }

        .form-control {
            background: #0f0f1a !important;
            border: 1px solid #2a2a4a !important;
            color: #e0e0e0 !important;
            border-radius: 10px;
            padding: 12px 15px;
        }

        .form-control:focus {
            border-color: #E91E63 !important;
            box-shadow: 0 0 0 3px rgba(233,30,99,0.2) !important;
        }

        .form-label { color: #9090b0; font-size: 0.85rem; margin-bottom: 6px; }

        .btn-giris {
            background: linear-gradient(135deg, #E91E63, #9C27B0);
            color: white;
            border: none;
            padding: 13px;
            border-radius: 10px;
            font-weight: 600;
            width: 100%;
            font-size: 1rem;
            transition: opacity 0.2s;
            cursor: pointer;
        }

        .btn-giris:hover { opacity: 0.85; }

        .hata {
            background: rgba(220,53,69,0.15);
            border: 1px solid rgba(220,53,69,0.3);
            color: #f87171;
            padding: 10px 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="login-wrap">
        <!-- SOL TARAF -->
        <div class="login-left">
            <div>
                <h2>💇‍♀️ Cicim Kuaför BeautyManager</h2>
                <p>Cicim Kuaför salonu tüm hakları saklıdır.</p>
            </div>
            <div class="features">
                <div><i class="fas fa-calendar-check"></i><span>Randevu Yönetimi</span></div>
                <div><i class="fas fa-bolt"></i><span>Lazer Seans Takibi</span></div>
                <div><i class="fas fa-box"></i><span>Stok Yönetimi</span></div>
                <div><i class="fas fa-chart-bar"></i><span>Gelir & Analiz</span></div>
            </div>
        </div>

        <!-- SAĞ TARAF -->
        <div class="login-right">
            <h3>Hoş Geldiniz Selda Hanım 👋</h3>
            <p>Devam etmek için giriş yapın</p>

            @if (ViewBag.Hata != null)
            {
                <div class="hata"><i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Hata</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Kullanıcı Adı</label>
                    <input type="text" name="kullaniciAdi" class="form-control" placeholder="admin" />
                </div>
                <div class="mb-4">
                    <label class="form-label">Şifre</label>
                    <input type="password" name="sifre" class="form-control" placeholder="••••••••" />
                </div>
                <button type="submit" class="btn-giris">
                    <i class="fas fa-sign-in-alt me-2"></i>Giriş Yap
                </button>
            </form>
        </div>
    </div>
</body>
</html>