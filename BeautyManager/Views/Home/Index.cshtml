 @{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cicim Kuaför — Tarsus, Mersin</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --rose: #FF6B9D;
            --rose-deep: #E91E8C;
            --blush: #FFB3D1;
            --nude: #F5E6ED;
            --gold: #D4A574;
            --gold-light: #F0C896;
            --cream: #FFF8F5;
            --dark: #1A0A12;
            --dark2: #2D1420;
            --text: #4A2035;
            --text-light: #8B5E75;
            --white: #FFFFFF;
        }

        html { scroll-behavior: smooth; }

        body {
            background: var(--cream);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            overflow-x: hidden;
        }

        /* ===== CUSTOM CURSOR ===== */
        .cursor {
            width: 12px; height: 12px;
            background: var(--rose-deep);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 9999;
            transition: transform 0.1s;
            mix-blend-mode: multiply;
        }

        .cursor-ring {
            width: 36px; height: 36px;
            border: 1.5px solid var(--rose);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 9998;
            transition: all 0.15s ease;
            mix-blend-mode: multiply;
        }

        /* ===== NAVBAR ===== */
        .navbar {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 1000;
            padding: 18px 0;
            transition: all 0.4s;
        }

        .navbar.scrolled {
            background: rgba(255,248,245,0.95);
            backdrop-filter: blur(20px);
            box-shadow: 0 2px 30px rgba(255,107,157,0.1);
            padding: 12px 0;
        }

        .nav-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-logo {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            font-weight: 700;
            color: var(--dark);
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .nav-logo span { color: var(--rose-deep); font-style: italic; }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 8px;
            list-style: none;
        }

        .nav-links a {
            color: var(--text-light);
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 500;
            padding: 8px 16px;
            border-radius: 30px;
            transition: all 0.2s;
        }

        .nav-links a:hover { color: var(--rose-deep); background: rgba(233,30,140,0.06); }

        .nav-wa-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            background: linear-gradient(135deg, #25D366, #128C7E);
            color: white !important;
            padding: 10px 22px !important;
            border-radius: 30px !important;
            font-weight: 600 !important;
            font-size: 0.85rem !important;
            box-shadow: 0 4px 15px rgba(37,211,102,0.3);
            transition: all 0.3s !important;
        }

        .nav-wa-btn:hover {
            transform: translateY(-2px) !important;
            box-shadow: 0 8px 25px rgba(37,211,102,0.4) !important;
            background: rgba(0,0,0,0) !important;
            background: linear-gradient(135deg, #25D366, #128C7E) !important;
        }

        /* ===== HERO ===== */
        .hero {
            min-height: 100vh;
            position: relative;
            display: flex;
            align-items: center;
            overflow: hidden;
            background: linear-gradient(150deg, #FFF0F5 0%, #FFF8F5 40%, #FFF5F8 100%);
        }

        /* Dekoratif daireler */
        .hero-daire-1 {
            position: absolute;
            width: 700px; height: 700px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255,107,157,0.12) 0%, transparent 70%);
            top: -200px; right: -150px;
            animation: pulse-slow 6s ease-in-out infinite;
        }

        .hero-daire-2 {
            position: absolute;
            width: 400px; height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(212,165,116,0.15) 0%, transparent 70%);
            bottom: -100px; left: -100px;
            animation: pulse-slow 8s ease-in-out infinite reverse;
        }

        .hero-daire-3 {
            position: absolute;
            width: 200px; height: 200px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255,107,157,0.08) 0%, transparent 70%);
            top: 30%; left: 40%;
        }

        /* Dekoratif çizgiler */
        .hero-cizgi {
            position: absolute;
            top: 0; bottom: 0;
            right: 42%;
            width: 1px;
            background: linear-gradient(180deg, transparent, rgba(255,107,157,0.2), transparent);
        }

        .hero-noktalar {
            position: absolute;
            top: 20%; right: 8%;
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
            opacity: 0.3;
        }

        .hero-noktalar span {
            width: 5px; height: 5px;
            background: var(--rose);
            border-radius: 50%;
            display: block;
        }

        .hero-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 100px 30px 60px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
            position: relative;
            z-index: 2;
        }

        /* Sol taraf */
        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: white;
            border: 1px solid rgba(255,107,157,0.2);
            box-shadow: 0 4px 15px rgba(255,107,157,0.1);
            padding: 8px 18px;
            border-radius: 30px;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--rose-deep);
            margin-bottom: 28px;
            letter-spacing: 0.5px;
        }

        .hero-tag .dot {
            width: 8px; height: 8px;
            background: #4ade80;
            border-radius: 50%;
            animation: blink 2s infinite;
        }

        .hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.8rem, 5vw, 4.5rem);
            font-weight: 900;
            color: var(--dark);
            line-height: 1.1;
            margin-bottom: 24px;
            letter-spacing: -1px;
        }

        .hero h1 em {
            font-style: italic;
            color: var(--rose-deep);
            position: relative;
        }

        .hero h1 em::after {
            content: '';
            position: absolute;
            bottom: -4px; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--rose-deep), var(--blush));
            border-radius: 2px;
        }

        .hero-desc {
            font-size: 1rem;
            color: var(--text-light);
            line-height: 1.85;
            margin-bottom: 36px;
            max-width: 440px;
        }

        .hero-btnler {
            display: flex;
            gap: 14px;
            flex-wrap: wrap;
            margin-bottom: 48px;
        }

        .btn-wa {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: linear-gradient(135deg, #25D366, #128C7E);
            color: white;
            padding: 15px 30px;
            border-radius: 14px;
            font-size: 0.95rem;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s;
            box-shadow: 0 8px 25px rgba(37,211,102,0.3);
        }

        .btn-wa:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 35px rgba(37,211,102,0.4);
            color: white;
        }

        .btn-kesfet {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: white;
            border: 1.5px solid rgba(233,30,140,0.2);
            color: var(--rose-deep);
            padding: 15px 28px;
            border-radius: 14px;
            font-size: 0.95rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(233,30,140,0.08);
        }

        .btn-kesfet:hover {
            border-color: var(--rose-deep);
            background: rgba(233,30,140,0.04);
            transform: translateY(-2px);
            color: var(--rose-deep);
        }

        /* HERO STATS */
        .hero-stats {
            display: flex;
            gap: 30px;
            padding-top: 36px;
            border-top: 1px solid rgba(255,107,157,0.15);
        }

        .hero-stat { }

        .hero-stat-sayi {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 900;
            color: var(--rose-deep);
            line-height: 1;
        }

        .hero-stat-label {
            font-size: 0.75rem;
            color: var(--text-light);
            margin-top: 3px;
            font-weight: 500;
        }

        /* SAĞ TARAF — Hizmet kartları */
        .hero-sag { position: relative; }

        .hizmet-float-kart {
            background: white;
            border-radius: 20px;
            padding: 20px 22px;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 16px;
            box-shadow: 0 8px 30px rgba(255,107,157,0.1);
            border: 1px solid rgba(255,107,157,0.08);
            transition: all 0.3s;
            animation: slide-in 0.6s ease both;
        }

        .hizmet-float-kart:hover {
            transform: translateX(-8px);
            box-shadow: 0 12px 40px rgba(255,107,157,0.2);
        }

        .hizmet-float-kart:nth-child(1) { animation-delay: 0.1s; }
        .hizmet-float-kart:nth-child(2) { animation-delay: 0.2s; }
        .hizmet-float-kart:nth-child(3) { animation-delay: 0.3s; }
        .hizmet-float-kart:nth-child(4) { animation-delay: 0.4s; }

        @@keyframes yuzen {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
}

.hero-sag {
    animation: float-up 0.8s ease both 0.3s, yuzen 5s ease-in-out 1s infinite !important;
}
        .hf-ikon {
            width: 50px; height: 50px;
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .hf-ikon-rose   { background: linear-gradient(135deg, #FFE0EC, #FFB3D1); color: #C2185B; }
        .hf-ikon-purple { background: linear-gradient(135deg, #F3E5F5, #CE93D8); color: #7B1FA2; }
        .hf-ikon-blue   { background: linear-gradient(135deg, #E3F2FD, #90CAF9); color: #1565C0; }
        .hf-ikon-gold   { background: linear-gradient(135deg, #FFF8E1, #FFCC02); color: #E65100; }

        .hf-kart-icerik h6 { color: var(--dark); font-weight: 700; margin: 0 0 3px; font-size: 0.9rem; }
        .hf-kart-icerik p  { color: var(--text-light); font-size: 0.78rem; margin: 0; }

        .hf-badge {
            margin-left: auto;
            background: #F0FFF4;
            color: #22C55E;
            border: 1px solid #BBF7D0;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.72rem;
            font-weight: 700;
            white-space: nowrap;
        }

        /* ===== ŞERIT ===== */
        .serit {
            background: linear-gradient(135deg, var(--rose-deep), #C2185B);
            padding: 16px 0;
            overflow: hidden;
            position: relative;
        }

        .serit-icerik {
            display: flex;
            gap: 50px;
            animation: kaydir 20s linear infinite;
            white-space: nowrap;
        }

        .serit-item {
            display: flex;
            align-items: center;
            gap: 10px;
            color: rgba(255,255,255,0.9);
            font-size: 0.85rem;
            font-weight: 500;
        }

        .serit-item i { color: var(--gold-light); }

        /* ===== HİZMETLER ===== */
        .bolum { padding: 100px 0; }
        .bolum-krem { background: #FFF8F5; }
        .bolum-beyaz { background: white; }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 30px; }

        .bolum-baslik {
            text-align: center;
            margin-bottom: 60px;
        }

        .bolum-etiket {
            display: inline-block;
            background: linear-gradient(135deg, rgba(233,30,140,0.1), rgba(212,165,116,0.1));
            border: 1px solid rgba(233,30,140,0.15);
            color: var(--rose-deep);
            padding: 6px 16px;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 16px;
        }

        .bolum-baslik h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2.6rem;
            font-weight: 900;
            color: var(--dark);
            margin-bottom: 14px;
            letter-spacing: -0.5px;
            line-height: 1.2;
        }

        .bolum-baslik h2 em { font-style: italic; color: var(--rose-deep); }

        .bolum-baslik p { color: var(--text-light); font-size: 0.95rem; line-height: 1.7; }

        /* Hizmet kartları */
        .hizmetler-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .hz-kart {
            background: white;
            border-radius: 24px;
            padding: 32px 26px;
            border: 1.5px solid rgba(255,107,157,0.08);
            transition: all 0.35s;
            position: relative;
            overflow: hidden;
            cursor: default;
        }

        .hz-kart::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--rose-deep), var(--gold));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.35s;
        }

        .hz-kart:hover {
            transform: translateY(-8px);
            border-color: rgba(255,107,157,0.25);
            box-shadow: 0 20px 50px rgba(255,107,157,0.15);
        }

        .hz-kart:hover::before { transform: scaleX(1); }

        .hz-kart-ikon {
            width: 64px; height: 64px;
            border-radius: 18px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 20px;
        }

        .hz-kart h5 {
            font-family: 'Playfair Display', serif;
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 10px;
        }

        .hz-kart p {
            color: var(--text-light);
            font-size: 0.875rem;
            line-height: 1.75;
            margin-bottom: 18px;
        }

        .hz-fiyat {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: linear-gradient(135deg, #FFF0F5, #FFE0EC);
            border: 1px solid rgba(255,107,157,0.2);
            color: var(--rose-deep);
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 0.8rem;
            font-weight: 700;
        }

        /* ===== NEDEN BİZ ===== */
        .neden-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
        }

        .neden-sol h2 {
            font-family: 'Playfair Display', serif;
            font-size: 2.4rem;
            font-weight: 900;
            color: var(--dark);
            margin-bottom: 30px;
            line-height: 1.2;
        }

        .neden-sol h2 em { font-style: italic; color: var(--rose-deep); }

        .neden-kart {
            background: white;
            border: 1.5px solid rgba(255,107,157,0.08);
            border-radius: 16px;
            padding: 20px 22px;
            display: flex;
            gap: 16px;
            margin-bottom: 12px;
            transition: all 0.25s;
        }

        .neden-kart:hover {
            border-color: rgba(255,107,157,0.25);
            transform: translateX(6px);
            box-shadow: 0 8px 25px rgba(255,107,157,0.1);
        }

        .neden-ikon {
            width: 46px; height: 46px;
            background: linear-gradient(135deg, var(--rose-deep), #C2185B);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: white; font-size: 1rem;
            flex-shrink: 0;
            box-shadow: 0 6px 15px rgba(233,30,140,0.25);
        }

        .neden-kart h6 { color: var(--dark); font-weight: 700; margin: 0 0 4px; font-size: 0.92rem; }
        .neden-kart p  { color: var(--text-light); font-size: 0.82rem; line-height: 1.6; margin: 0; }

        /* Sayı kartları */
        .sayilar-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .sayi-kart {
            background: white;
            border: 1.5px solid rgba(255,107,157,0.1);
            border-radius: 20px;
            padding: 28px 20px;
            text-align: center;
            transition: all 0.3s;
        }

        .sayi-kart:hover {
            border-color: rgba(255,107,157,0.3);
            transform: translateY(-5px);
            box-shadow: 0 12px 35px rgba(255,107,157,0.12);
        }

        .sayi-rakam {
            font-family: 'Playfair Display', serif;
            font-size: 3rem;
            font-weight: 900;
            background: linear-gradient(135deg, var(--rose-deep), var(--gold));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1;
            margin-bottom: 6px;
        }

        .sayi-etiket { color: var(--text-light); font-size: 0.8rem; font-weight: 500; }

        .konum-kart {
            background: linear-gradient(135deg, #FFF0F5, #FFF8F0);
            border: 1.5px solid rgba(255,107,157,0.15);
            border-radius: 20px;
            padding: 24px 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            grid-column: span 2;
        }

        .konum-kart .ikon {
            font-size: 2rem;
            flex-shrink: 0;
        }

        .konum-kart h6 { color: var(--dark); font-weight: 700; margin: 0 0 4px; }
        .konum-kart p  { color: var(--text-light); font-size: 0.82rem; margin: 0; }

        .acik-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #F0FFF4;
            border: 1px solid #BBF7D0;
            color: #16A34A;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.72rem;
            font-weight: 700;
            margin-top: 5px;
        }

        /* ===== İLETİŞİM ===== */
        .iletisim-wrap {
            max-width: 720px;
            margin: 0 auto;
        }

        .iletisim-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-bottom: 30px;
        }

        .iletisim-kart {
            background: white;
            border: 1.5px solid rgba(255,107,157,0.1);
            border-radius: 16px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 14px;
            transition: all 0.25s;
        }

        .iletisim-kart:hover {
            border-color: rgba(255,107,157,0.3);
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(255,107,157,0.1);
        }

        .iletisim-ikon {
            width: 46px; height: 46px;
            background: linear-gradient(135deg, #FFE0EC, #FFB3D1);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: var(--rose-deep);
            font-size: 1rem;
            flex-shrink: 0;
        }

        .iletisim-kart h6 {
            color: var(--text-light);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 0 0 3px;
            font-weight: 600;
        }

        .iletisim-kart p { color: var(--dark); font-weight: 700; margin: 0; font-size: 0.92rem; }

        /* WA MEGA BUTON */
        .wa-mega-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            background: linear-gradient(135deg, #25D366, #128C7E);
            color: white;
            padding: 20px 50px;
            border-radius: 18px;
            font-size: 1.1rem;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s;
            box-shadow: 0 12px 35px rgba(37,211,102,0.3);
            position: relative;
            overflow: hidden;
        }

        .wa-mega-btn::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
            transition: left 0.5s;
        }

        .wa-mega-btn:hover::before { left: 100%; }

        .wa-mega-btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 50px rgba(37,211,102,0.4);
            color: white;
        }

        .wa-mega-btn .wa-ikon {
            font-size: 1.6rem;
            animation: wa-shake 2.5s infinite;
        }

        /* ===== FOOTER ===== */
        .footer {
            background: var(--dark);
            padding: 40px 0;
        }

        .footer-inner {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 15px;
        }

        .footer-logo {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: white;
        }

        .footer-logo span { color: var(--rose); font-style: italic; }
        .footer-yazi { color: rgba(255,255,255,0.4); font-size: 0.82rem; }

        /* ===== ANİMASYONLAR ===== */
        @@keyframes pulse-slow {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.05); opacity: 0.8; }
        }

        @@keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        @@keyframes kaydir {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

