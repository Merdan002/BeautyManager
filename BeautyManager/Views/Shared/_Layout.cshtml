 <!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>💇‍♀️ BeautyManager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background: #0f0f1a;
            color: #e0e0e0;
            font-family: 'Segoe UI', sans-serif;
            display: flex;
            min-height: 100vh;
        }

        /* ---- SIDEBAR ---- */
        .sidebar {
            width: 260px;
            min-height: 100vh;
            background: linear-gradient(180deg, #1a1a2e, #16213e);
            padding: 25px 15px;
            position: fixed;
            top: 0; left: 0;
            border-right: 1px solid #2a2a4a;
            z-index: 100;
            overflow-y: auto;
        }

        .sidebar-brand {
            font-size: 1.3rem;
            font-weight: 800;
            color: white;
            margin-bottom: 30px;
            display: block;
            text-decoration: none;
            padding: 0 10px;
        }

        .sidebar-brand span {
            background: linear-gradient(135deg, #E91E63, #9C27B0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-section {
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #444470;
            margin: 20px 0 8px 10px;
        }

        .sidebar .nav-link {
            color: #8080a0 !important;
            padding: 10px 15px;
            border-radius: 10px;
            margin-bottom: 3px;
            transition: all 0.2s;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background: linear-gradient(135deg, rgba(233,30,99,0.2), rgba(156,39,176,0.2));
            color: white !important;
            border-left: 3px solid #E91E63;
        }

        .sidebar .nav-link i { width: 18px; text-align: center; }

        /* ---- MAIN ---- */
        .main-content {
            margin-left: 260px;
            flex: 1;
            padding: 25px 30px;
        }

        /* ---- TOPBAR ---- */
        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 20px;
            border-bottom: 1px solid #2a2a4a;
        }

        .topbar h4 { color: white; font-weight: 700; margin: 0; }
        .topbar small { color: #6060a0; }

        .btn-new {
            background: linear-gradient(135deg, #E91E63, #9C27B0);
            color: white !important;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            font-size: 0.9rem;
            transition: opacity 0.2s;
        }

        .btn-new:hover { opacity: 0.85; }

        /* ---- STAT CARDS ---- */
        .stat-card {
            background: #1a1a2e;
            border: 1px solid #2a2a4a;
            border-radius: 16px;
            padding: 22px;
            margin-bottom: 20px;
            transition: transform 0.2s;
        }

        .stat-card:hover { transform: translateY(-2px); }

        .stat-card .icon {
            width: 46px; height: 46px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.2rem;
            margin-bottom: 12px;
        }

        .icon-pink   { background: rgba(233,30,99,0.15);  color: #f06292; }
        .icon-purple { background: rgba(156,39,176,0.15); color: #ce93d8; }
        .icon-blue   { background: rgba(13,110,253,0.15); color: #60a5fa; }
        .icon-green  { background: rgba(25,135,84,0.15);  color: #4ade80; }
        .icon-orange { background: rgba(255,152,0,0.15);  color: #ffb74d; }
        .icon-red    { background: rgba(220,53,69,0.15);  color: #f87171; }

        .stat-card h3 { color: white; font-size: 1.8rem; font-weight: 700; margin: 0; }
        .stat-card p  { color: #6060a0; font-size: 0.82rem; margin: 4px 0 0; }

        /* ---- TABLE CARD ---- */
        .table-card {
            background: #1a1a2e;
            border: 1px solid #2a2a4a;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .table-card h6 {
            color: white;
            font-weight: 600;
            margin-bottom: 15px;
            padding-bottom: 12px;
            border-bottom: 1px solid #2a2a4a;
        }

        .table { color: #e0e0e0; }
        .table thead th {
            color: #6060a0;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-color: #2a2a4a;
            font-weight: 600;
        }

        .table td { border-color: #2a2a4a; vertical-align: middle; font-size: 0.9rem; }
        .table tbody tr:hover { background: rgba(255,255,255,0.03); }

        /* ---- BADGES ---- */
        .badge-bekliyor  { background: rgba(255,152,0,0.15);  color: #ffb74d; padding: 4px 10px; border-radius: 20px; font-size: 0.78rem; }
        .badge-tamamlandi{ background: rgba(25,135,84,0.15);  color: #4ade80; padding: 4px 10px; border-radius: 20px; font-size: 0.78rem; }
        .badge-iptal     { background: rgba(220,53,69,0.15);  color: #f87171; padding: 4px 10px; border-radius: 20px; font-size: 0.78rem; }
        .badge-odendi    { background: rgba(25,135,84,0.15);  color: #4ade80; padding: 4px 10px; border-radius: 20px; font-size: 0.78rem; }
        .badge-bekleyen  { background: rgba(220,53,69,0.15);  color: #f87171; padding: 4px 10px; border-radius: 20px; font-size: 0.78rem; }

        /* ---- FORM ---- */
        .form-card {
            background: #1a1a2e;
            border: 1px solid #2a2a4a;
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 20px;
        }

        .form-control, .form-select {
            background: #0f0f1a !important;
            border: 1px solid #2a2a4a !important;
            color: #e0e0e0 !important;
            border-radius: 10px;
        }

        .form-control:focus, .form-select:focus {
            border-color: #E91E63 !important;
            box-shadow: 0 0 0 3px rgba(233,30,99,0.2) !important;
        }

        .form-label { color: #9090b0; font-size: 0.85rem; margin-bottom: 5px; }

        .btn-save {
            background: linear-gradient(135deg, #E91E63, #9C27B0);
            color: white;
            border: none;
            padding: 11px 28px;
            border-radius: 10px;
            font-weight: 600;
            transition: opacity 0.2s;
            cursor: pointer;
        }

        .btn-save:hover { opacity: 0.85; color: white; }

        .btn-edit {
            background: rgba(13,110,253,0.15);
            color: #60a5fa;
            border: none;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.82rem;
            text-decoration: none;
            transition: background 0.2s;
        }

        .btn-edit:hover { background: rgba(13,110,253,0.3); color: #60a5fa; }

        .btn-delete {
            background: rgba(220,53,69,0.15);
            color: #f87171;
            border: none;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.82rem;
            text-decoration: none;
            transition: background 0.2s;
        }

        .btn-delete:hover { background: rgba(220,53,69,0.3); color: #f87171; }

        .btn-success-soft {
            background: rgba(25,135,84,0.15);
            color: #4ade80;
            border: none;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.82rem;
            text-decoration: none;
            transition: background 0.2s;
        }

        .btn-success-soft:hover { background: rgba(25,135,84,0.3); color: #4ade80; }

        /* ---- PROGRESS BAR ---- */
        .progress {
            background: #0f0f1a;
            border-radius: 10px;
            height: 8px;
        }

        .progress-bar-pink {
            background: linear-gradient(135deg, #E91E63, #9C27B0);
        }

        /* ---- EMPTY STATE ---- */
        .empty-state {
            text-align: center;
            padding: 40px;
            color: #4040a0;
        }

        .empty-state i { font-size: 2.5rem; margin-bottom: 12px; display: block; }

        /* ---- ALERT ---- */
        .alert-soft {
            background: rgba(220,53,69,0.1);
            border: 1px solid rgba(220,53,69,0.2);
            color: #f87171;
            border-radius: 10px;
            padding: 12px 16px;
            font-size: 0.88rem;
        }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <a class="sidebar-brand" href="/Dashboard">
            💇‍♀️ <span>BeautyManager</span>
        </a>

        <div class="nav-section">Ana Menü</div>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" href="/Dashboard">
            <i class="fas fa-home"></i> Dashboard
        </a>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Randevu" ? "active" : "")" href="/Randevu">
            <i class="fas fa-calendar-check"></i> Randevular
        </a>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "LazerSeans" ? "active" : "")" href="/LazerSeans">
            <i class="fas fa-bolt"></i> Lazer Seansları
        </a>

        <div class="nav-section">Yönetim</div>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Musteri" ? "active" : "")" href="/Musteri">
            <i class="fas fa-users"></i> Müşteriler
        </a>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Personel" ? "active" : "")" href="/Personel">
            <i class="fas fa-user-tie"></i> Personel
        </a>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Stok" ? "active" : "")" href="/Stok">
            <i class="fas fa-box"></i> Stok Yönetimi
        </a>
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Fiyat" ? "active" : "")" href="/Fiyat">
            <i class="fas fa-tags"></i> Fiyat Listesi
        </a>

        <div class="nav-section">Hesap</div>
        <a class="nav-link" href="/Giris/Cikis">
            <i class="fas fa-sign-out-alt"></i> Çıkış Yap
        </a>
    </div>

    <!-- MAIN -->
    <div class="main-content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</body>
</html>