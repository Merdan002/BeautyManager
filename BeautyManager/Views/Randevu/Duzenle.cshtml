@model BeautyManager.Models.Randevu

<div class="topbar">
    <div>
        <h4><i class="fas fa-edit me-2" style="color:#E91E63"></i>Randevu Düzenle</h4>
        <small>Randevu bilgilerini güncelleyin</small>
    </div>
    <a href="/Randevu" class="btn-edit"><i class="fas fa-arrow-left me-2"></i>Geri Dön</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="form-card">
            <form method="post">
                <input type="hidden" asp-for="Id" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Müşteri</label>
                        <select asp-for="MusteriId" class="form-select">
                            @foreach (var m in ViewBag.Musteriler as List<BeautyManager.Models.Musteri>)
                            {
                                <option value="@m.Id">@m.Ad @m.Soyad — @m.Telefon</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Personel</label>
                        <select asp-for="PersonelId" class="form-select">
                            @foreach (var p in ViewBag.Personeller as List<BeautyManager.Models.Personel>)
                            {
                                <option value="@p.Id">@p.Ad @p.Soyad</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tarih ve Saat</label>
                        <input asp-for="RandevuTarihi" type="datetime-local" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ücret (₺)</label>
                        <input asp-for="Ucret" type="number" step="0.01" class="form-control" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">İşlem Açıklaması</label>
                        <input asp-for="IslemAciklamasi" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Durum</label>
                        <select asp-for="Durum" class="form-select">
                            <option value="Bekliyor">Bekliyor</option>
                            <option value="Tamamlandı">Tamamlandı</option>
                            <option value="İptal">İptal</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ödeme Durumu</label>
                        <select asp-for="OdendiMi" class="form-select">
                            <option value="false">Ödenmedi</option>
                            <option value="true">Ödendi</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Notlar</label>
                        <textarea asp-for="Notlar" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-12 d-flex gap-3">
                        <button type="submit" class="btn-save"><i class="fas fa-save me-2"></i>Güncelle</button>
                        <a href="/Randevu" class="btn-delete">İptal</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>