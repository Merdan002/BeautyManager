 @model BeautyManager.Models.Randevu

<div class="topbar">
    <div>
        <h4><i class="fas fa-plus-circle me-2" style="color:#E91E63"></i>Yeni Randevu</h4>
        <small>Yeni randevu oluşturun</small>
    </div>
    <a href="/Randevu" class="btn-edit"><i class="fas fa-arrow-left me-2"></i>Geri Dön</a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="form-card">
            <form method="post" action="/Randevu/Ekle">

                @if (ViewBag.Hata != null)
                {
                    <div style="background:rgba(220,53,69,0.15); border:1px solid rgba(220,53,69,0.3);
                                color:#f87171; padding:12px 16px; border-radius:10px; margin-bottom:20px;">
                        <i class="fas fa-exclamation-circle me-2"></i>@ViewBag.Hata
                    </div>
                }

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Müşteri</label>
                        <div class="arama-wrap" id="musteriWrap">
                            <input type="text" id="musteriArama" class="form-control"
                                   placeholder="Ad, soyad veya telefon ile ara..." autocomplete="off" />
                            <input type="hidden" name="MusteriId" id="musteriId" />
                            <input type="hidden" name="MusteriAdi" id="musteriAdiHidden" />
                            <div class="arama-liste" id="musteriListe"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Personel</label>
                        <div class="arama-wrap" id="personelWrap">
                            <input type="text" id="personelArama" class="form-control"
                                   placeholder="Personel adı ile ara..." autocomplete="off" />
                            <input type="hidden" name="PersonelId" id="personelId" />
                            <input type="hidden" name="PersonelAdi" id="personelAdiHidden" />
                            <div class="arama-liste" id="personelListe"></div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tarih ve Saat</label>
                        <input name="RandevuTarihi" type="datetime-local" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ücret (₺)</label>
                        <input name="Ucret" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">İşlem Açıklaması</label>
                        <input name="IslemAciklamasi" class="form-control" placeholder="Örn: Saç kesim + boyama" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Durum</label>
                        <select name="Durum" class="form-select">
                            <option value="Bekliyor">Bekliyor</option>
                            <option value="Tamamlandı">Tamamlandı</option>
                            <option value="İptal">İptal</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ödeme Durumu</label>
                        <select name="OdendiMi" class="form-select">
                            <option value="false">Ödenmedi</option>
                            <option value="true">Ödendi</option>
                        </select>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Notlar</label>
                        <textarea name="Notlar" class="form-control" rows="3" placeholder="Opsiyonel notlar..."></textarea>
                    </div>
                    <div class="col-12 d-flex gap-3">
                        <button type="submit" class="btn-save"><i class="fas fa-save me-2"></i>Kaydet</button>
                        <a href="/Randevu" class="btn-delete">İptal</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .arama-wrap { position: relative; }

    .arama-liste {
        position: absolute;
        top: 100%; left: 0; right: 0;
        background: #1a1a2e;
        border: 1px solid #E91E63;
        border-top: none;
        border-radius: 0 0 10px 10px;
        max-height: 220px;
        overflow-y: auto;
        z-index: 100;
        display: none;
    }

    .arama-liste.acik { display: block; }

    .arama-item {
        padding: 10px 15px;
        cursor: pointer;
        font-size: 0.88rem;
        color: #e0e0e0;
        border-bottom: 1px solid #2a2a4a;
        transition: background 0.15s;
    }

    .arama-item:last-child { border-bottom: none; }
    .arama-item:hover { background: rgba(233,30,99,0.15); color: white; }
    .arama-item .alt-bilgi { color: #6060a0; font-size: 0.78rem; margin-top: 2px; }
    .arama-item.secili { background: rgba(233,30,99,0.2); color: white; }
</style>

<script>
    var musteriler = [
        @foreach (var m in ViewBag.Musteriler as List<BeautyManager.Models.Musteri>)
        {
            <text>{ id: @m.Id, ad: "@m.Ad @m.Soyad", telefon: "@m.Telefon" },</text>
        }
    ];

    var personeller = [
        @foreach (var p in ViewBag.Personeller as List<BeautyManager.Models.Personel>)
        {
            <text>{ id: @p.Id, ad: "@p.Ad @p.Soyad", uzmanlik: "@p.Uzmanlik" },</text>
        }
    ];

    function aramaKurulum(inputId, listeId, idInputId, veri) {
        var input = document.getElementById(inputId);
        var liste = document.getElementById(listeId);
        var idInput = document.getElementById(idInputId);

        input.addEventListener('input', function () {
            var aranan = this.value.toLowerCase().trim();
            liste.innerHTML = '';
            idInput.value = '';

            var filtreli = aranan.length === 0 ? veri : veri.filter(function (item) {
                return item.ad.toLowerCase().includes(aranan) ||
                       (item.telefon && item.telefon.toLowerCase().includes(aranan));
            });

            if (filtreli.length === 0) {
                liste.innerHTML = '<div class="arama-item" style="color:#6060a0">Sonuç bulunamadı</div>';
            } else {
                filtreli.forEach(function (item) { listeEkle(item, liste, idInput, input); });
            }
            liste.classList.add('acik');
        });

        input.addEventListener('focus', function () {
            liste.innerHTML = '';
            veri.forEach(function (item) { listeEkle(item, liste, idInput, input); });
            liste.classList.add('acik');
        });

        document.addEventListener('click', function (e) {
            if (!input.contains(e.target) && !liste.contains(e.target))
                liste.classList.remove('acik');
        });
    }

    function listeEkle(item, liste, idInput, input) {
        var div = document.createElement('div');
        div.className = 'arama-item';
        div.innerHTML = '<div>' + item.ad + '</div>' +
                        '<div class="alt-bilgi">' + (item.telefon || item.uzmanlik || '') + '</div>';
        div.addEventListener('click', function () {
            idInput.value = item.id;
            input.value = item.ad;
            liste.classList.remove('acik');
        });
        liste.appendChild(div);
    }

    aramaKurulum('musteriArama', 'musteriListe', 'musteriId', musteriler);
    aramaKurulum('personelArama', 'personelListe', 'personelId', personeller);
    // Elle yazma takibi
document.getElementById('musteriArama').addEventListener('input', function() {
    document.getElementById('musteriAdiHidden').value = this.value;
    document.getElementById('musteriId').value = '';
});
document.getElementById('personelArama').addEventListener('input', function() {
    document.getElementById('personelAdiHidden').value = this.value;
    document.getElementById('personelId').value = '';
});
</script>