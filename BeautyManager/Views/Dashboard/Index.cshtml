@model List<BeautyManager.Models.Randevu>

<!-- TOPBAR -->
<div class="topbar">
    <div>
        <h4>📊 Selda Karaca</h4>
        <small>@DateTime.Now.ToString("dd MMMM yyyy, dddd") — Hoş geldiniz!</small>
    </div>
    <div class="d-flex gap-2">
        <a href="/Dashboard/WhatsappOzet" target="_blank" class="btn-new"
               style="background:linear-gradient(135deg,#25D366,#128C7E); box-shadow:0 4px 15px rgba(37,211,102,0.3)">
            <i class="fab fa-whatsapp me-2"></i>Günlük Özet Gönder
        </a>
        <a href="/Randevu/Ekle" class="btn-new">
            <i class="fas fa-plus me-2"></i>Yeni Randevu
        </a>
    </div>
</div>

<!-- STAT CARDS -->
<div class="row">
    <div class="col-md-2 col-sm-4">
        <div class="stat-card">
            <div class="icon icon-pink"><i class="fas fa-calendar-day"></i></div>
            <h3>@ViewBag.BugunRandevuSayisi</h3>
            <p>Bugünkü Randevu</p>
        </div>
    </div>
    <div class="col-md-2 col-sm-4">
        <div class="stat-card">
            <div class="icon icon-purple"><i class="fas fa-calendar-week"></i></div>
            <h3>@ViewBag.HaftalikRandevu</h3>
            <p>Haftalık Randevu</p>
        </div>
    </div>
    <div class="col-md-2 col-sm-4">
        <div class="stat-card">
            <div class="icon icon-green"><i class="fas fa-money-bill-wave"></i></div>
            <h3>@ViewBag.AylikGelir₺</h3>
            <p>Aylık Gelir</p>
        </div>
    </div>
    <div class="col-md-2 col-sm-4">
        <div class="stat-card">
            <div class="icon icon-red"><i class="fas fa-clock"></i></div>
            <h3>@ViewBag.BekleyenOdeme</h3>
            <p>Bekleyen Ödeme</p>
        </div>
    </div>
    <div class="col-md-2 col-sm-4">
        <div class="stat-card">
            <div class="icon icon-blue"><i class="fas fa-users"></i></div>
            <h3>@ViewBag.ToplamMusteri</h3>
            <p>Toplam Müşteri</p>
        </div>
    </div>
    <div class="col-md-2 col-sm-4">
        <div class="stat-card">
            <div class="icon icon-orange"><i class="fas fa-box-open"></i></div>
            <h3>@ViewBag.DusukStok</h3>
            <p>Düşük Stok</p>
        </div>
    </div>
</div>

<!-- DOLULUK ORANI -->
<div class="table-card mb-4">
    <h6><i class="fas fa-chart-pie me-2" style="color:#E91E63"></i>Günlük Doluluk Oranı</h6>
    <div class="d-flex justify-content-between mb-2">
        <small style="color:#9090b0">@ViewBag.BugunRandevuSayisi / 10 Randevu</small>
        <small style="color:
            @(ViewBag.DolulukOrani >= 80 ? "#f87171" :
                             ViewBag.DolulukOrani >= 50 ? "#ffb74d" : "#4ade80")">
            %@ViewBag.DolulukOrani
        </small>
    </div>
    <div class="progress" style="height:12px">
        <div class="progress-bar progress-bar-pink"
             style="width: @ViewBag.DolulukOrani%;
            background: @(ViewBag.DolulukOrani >= 80 ? "linear-gradient(135deg,#f87171,#ef4444)" :
                                                           ViewBag.DolulukOrani >= 50 ? "linear-gradient(135deg,#ffb74d,#f59e0b)" :
                                                           "linear-gradient(135deg,#E91E63,#9C27B0)")">
        </div>
    </div>
</div>

<!-- GRAFİKLER -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="table-card">
            <h6><i class="fas fa-chart-bar me-2" style="color:#E91E63"></i>Haftalık Randevu</h6>
            <canvas id="haftalikChart" height="200"></canvas>
        </div>
    </div>
    <div class="col-md-6">
        <div class="table-card">
            <h6><i class="fas fa-chart-line me-2" style="color:#9C27B0"></i>Bu Ay vs Geçen Ay</h6>
            <canvas id="aylikChart" height="200"></canvas>
        </div>
    </div>
</div>

<!-- BUGÜNÜN RANDEVULARI -->
<div class="row">
    <div class="col-md-8">
        <div class="table-card">
            <h6><i class="fas fa-calendar-check me-2" style="color:#E91E63"></i>Bugünün Randevuları</h6>
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="fas fa-calendar-times"></i>
                    <p>Bugün randevu yok</p>
                </div>
            }
            else
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Saat</th>
                            <th>Müşteri</th>
                            <th>Personel</th>
                            <th>İşlem</th>
                            <th>Durum</th>
                            <th>Ödeme</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.RandevuTarihi.ToString("HH:mm")</td>
                                <td>@r.Musteri?.Ad @r.Musteri?.Soyad</td>
                                <td>@r.Personel?.Ad</td>
                                <td>@r.IslemAciklamasi</td>
                                <td>
                                    @if (r.Durum == "Tamamlandı")
                                    {
                                        <span class="badge-tamamlandi">✓ Tamamlandı</span>
                                    }
                                    else if (r.Durum == "İptal")
                                    {

                                        <span class="badge-iptal">✕ İptal</span>
                                    }
                                    else
                                    {

                                        <span class="badge-bekliyor">⏳ Bekliyor</span>
                                    }
                                </td>
                                <td>
                                    @if (r.OdendiMi)
                                    {
                                        <span class="badge-odendi">✓ Ödendi</span>
                                    }
                                    else
                                    {

                                        <span class="badge-bekleyen">✕ Bekliyor</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- DÜŞÜK STOK UYARILARI -->
    <div class="col-md-4">
        <div class="table-card">
            <h6><i class="fas fa-exclamation-triangle me-2" style="color:#ffb74d"></i>Düşük Stok Uyarıları</h6>
            @if (ViewBag.DusukStoklar != null)
            {
                var stoklar = ViewBag.DusukStoklar as List<BeautyManager.Models.MalzemeStok>;
                if (stoklar != null && stoklar.Any())
                {
                    @foreach (var stok in stoklar)
                    {
                        <div class="alert-soft mb-2">
                            <i class="fas fa-box me-2"></i>
                            <strong>@stok.UrunAdi</strong>
                            <span class="float-end">@stok.Miktar @stok.Birim</span>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-check-circle" style="color:#4ade80"></i>
                        <p style="color:#4ade80">Stok seviyeleri normal</p>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- GRAFİK SCRIPTS -->

    // Haftalık Grafik
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    window.addEventListener('load', function () {
    // Haftalık Grafik
    var ctx1 = document.getElementById('haftalikChart');
    if (ctx1) {
    new Chart(ctx1, {
    type: 'bar',
    data: {
    labels: [@Html.Raw(ViewBag.GrafikGunler)],
    datasets: [{
    label: 'Randevu',
    data: [@Html.Raw(ViewBag.GrafikSayilar)],
    backgroundColor: 'rgba(233,30,99,0.5)',
    borderColor: '#E91E63',
    borderWidth: 2,
    borderRadius: 6
    }]
    },
    options: {
    responsive: true,
    plugins: { legend: { display: false } },
    scales: {
    y: { ticks: { color: '#6060a0' }, grid: { color: '#2a2a4a' }, beginAtZero: true },
    x: { ticks: { color: '#6060a0' }, grid: { display: false } }
    }
    }
    });
    }

    // Aylık Karşılaştırma
    var ctx2 = document.getElementById('aylikChart');
    if (ctx2) {
    new Chart(ctx2, {
    type: 'bar',
    data: {
    labels: [@Html.Raw(ViewBag.AylikHaftalar)],
    datasets: [
    {
    label: 'Bu Ay',
    data: [@Html.Raw(ViewBag.BuAyData)],
    backgroundColor: 'rgba(233,30,99,0.5)',
    borderColor: '#E91E63',
    borderWidth: 2,
    borderRadius: 6
    },
    {
    label: 'Geçen Ay',
    data: [@Html.Raw(ViewBag.GecenAyData)],
    backgroundColor: 'rgba(156,39,176,0.3)',
    borderColor: '#9C27B0',
    borderWidth: 2,
    borderRadius: 6
    }
    ]
    },
    options: {
    responsive: true,
    plugins: { legend: { labels: { color: '#9090b0' } } },
    scales: {
    y: { ticks: { color: '#6060a0' }, grid: { color: '#2a2a4a' }, beginAtZero: true },
    x: { ticks: { color: '#6060a0' }, grid: { display: false } }
    }
    }
    });
    }
    });
</script>